!/output/multibanana_eval/

# M4 冒烟评测产物(2026-07-30):进对比总览图 + results.json + 单张原始生成图,
# 只排除 row_*.png(单行拼图,与总览图重复)。
!/output/smoke_eval/
/output/smoke_eval/*
!/output/smoke_eval/smoke_compare.png
!/output/smoke_eval/results.json
!/output/smoke_eval/case*__*.png
!/output/multibanana_eval_distill/
/output/multibanana_eval_distill/*
!/output/multibanana_eval_distill/compare_add.png
!/output/multibanana_eval_distill/results_add.json
!/output/multibanana_eval_distill/add_*__*.png

# M4 全量评测产物(2026-07-30,M4_EVAL_SPEC §5.2):进 results.json + JPEG 拼图;
# 711 张全分辨率 PNG(~250 MB)留在 H800 供 viewer 人工判读,不进 git。
!/output/eval_multiref/
/output/eval_multiref/*
!/output/eval_multiref/results.json
!/output/eval_multiref/boards/
# 人工盲评产物(2026-07-30):227 条标注 + 揭盲统计进 git,供报告引用与复算;
# PNG 候选图仍留在 H800 不进 git(与上方 M4 PNG 同理)。
!/output/eval_multiref/blind_rond1.json
!/output/eval_multiref/blind_stats.json
# 盲评 v2(2026-08-03,§11 步骤 0):配对清单与标注**必须**进 git——
# H800 靠 git pull 拿清单才起得来服务;标注要能被 report.py 离线复算与审计。
# 候选 PNG 仍留在 H800。blind_annotations_backups/ 是目录,不被下面两条命中,继续忽略。
!/output/eval_multiref/pairs_*.json
!/output/eval_multiref/blind_annotations_*.json

# 注意力诊断产物(2026-07-30,D03;2026-07-31 D04 更新):**全部进 git**。
# npz 是曲线/热力图数据,本地 plot_attn.py 靠它出图,不进 git 就没法出报告;
# D04 把曲线拆到 head 维度后单个 npz 从 342 KB 涨到 854–1068 KB(压缩前),
# 32 次合计约 28 MB,连同 32 张 PNG 全目录约 40 MB;
# PNG 是 32 张生成图,--verify_identical 要拿它与 eval_multiref 的同名图逐像素比;
# report.html / summary.json 是本地生成的产物,一并留档。
!/output/attn_diag/
/output/attn_diag/*
!/output/attn_diag/*.npz
!/output/attn_diag/*__*.png
!/output/attn_diag/results.json
!/output/attn_diag/summary.json
!/output/attn_diag/report.html

# 蒸馏产物：M1 会在 8 卡上生成约 8000 张 target 图（数百 MB），
# 连同 DINO 打分中间结果一起，都不该进 git——远程机器靠 git pull 同步代码，
# 一次 `git add -A` 就会把它们推到 fork 上。清单 json 体积小但依赖本地图片，
# 单独存在也无意义，一并忽略。
/datasets/distill_multiref/*
distill/*.json
distill/shards/
log/ref_distill/
!scripts/h800_setup.log
!/datasets/distill_multiref/images
/datasets/distill_multiref/images/*
!/datasets/distill_multiref/images_textonly
!/datasets/distill_multiref/board_floorline.png

# data/multibanana 全量数据(~2.5GB,远程 git pull 拉不动):用 download_multibanana_single_two.py 现拉
/data/multibanana

!output/noise_floor/results.json

# M5 P-probe 产物(2026-08-03,§11.4):results.json + 拼图进 git,
# 384 张全分辨率 PNG 留在 H800 供人工判读(与 eval_multiref 同理)。
!/output/probe_iso/
/output/probe_iso/*
!/output/probe_iso/results.json
!/output/probe_iso/boards/
